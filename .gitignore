node_modules/
dist/
dist-electron/
coverage/
.vite/
*.local

# `npm run plugins:build`'s output (ADR-0006 step 7, scripts/build-plugins.mjs):
# one `.lwplugin` per plugin under `plugins/*`. Generated, like `dist/`, and
# rebuilt by that script — not tracked, and not what the release attaches (the
# workflow that does is out of scope for this change; see the script's banner).
dist-plugins/

# The packaged desktop artefacts: installers, the unpacked application tree, and
# electron-builder's own bookkeeping. A THIRD build directory, and the third one
# is not an accident.
#
# `dist/` is Vite's, and `vite build` EMPTIES it, so anything else placed there is
# destroyed by the next renderer build. `dist-electron/` is where `tsc -p
# electron/tsconfig.json` emits the main and preload programs, and packaging reads
# from it rather than writing to it. Neither can hold the packaged output, so the
# packaged output gets its own name.
#
# Ignoring it is half the obligation. The other half is `SKIPPED_DIRECTORIES` in
# `scripts/check-citations.mjs`, which walks the working tree rather than the git
# index - an unpacked Electron application is roughly 200 MB of files it would
# otherwise read on every run. Both halves land in the same change, always.
release/

# Playwright's own output. Both are generated by `npm run test:browser` and are
# per-run artifacts: traces and screenshots of a failing run, and the HTML report
# over them. CI uploads them from the workflow instead of committing them.
test-results/
# `npm run test:packaged`'s output (ADR-0006 step 10): a trace, and the throwaway
# user-data directory the packaged app ran in, kept for inspection until the next run.
test-results-packaged/
playwright-report/
blob-report/
.playwright/

# Editor / OS
.vscode/*
.idea/
.DS_Store
Thumbs.db

# Agent / assistant local state.
#
# These are per-machine files, not project configuration. They were previously
# ignored only by the author's *global* gitignore, which does not travel with a
# clone - so on a second laptop they showed up untracked and one `git add .` away
# from being committed. Listed here so the repository ignores them itself.
#
# `.claude/` is deliberately NOT ignored wholesale: project-shared agent config
# can legitimately live there and must stay committable.
.claude/settings.local.json
.claude/*.local.json
.claude/shell-snapshots/
.claude/todos/
.claude/statsig/
.claude/history.jsonl

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
#
# Nothing in this repository reads an environment variable, so there is nothing to
# configure and no `.env.example` to un-ignore. These patterns stay as a guard
# against a secret file arriving later, not as a hint that one is expected.
.env
.env.*

# prove-claims writes its results here on a local run (review of PR A, L3)
claims-results.json
