{
  "name": "leapware-shellux",
  "private": true,
  "version": "0.1.0",
  "description": "LEAPWare ShellUX — a pluggable UI shell host.",
  "author": "LEAPWare Software",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "install-electron && npm run build:desktop && electron .",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tsc -p electron/tsconfig.json",
    "package:desktop": "electron-builder --publish never",
    "verify:desktop": "npm run build && npm run build:desktop && npm run package:desktop",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --sequence.shuffle src/__tests__/IntegrationSuite.test.tsx",
    "test:scripts": "node --test scripts/__tests__/check-portability.test.mjs scripts/__tests__/check-tokens.test.mjs",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check:portability": "node scripts/check-portability.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "verify": "npm run check:portability && npm run check:citations && npm run tokens:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:integration && npm run test:scripts && npm run build && npm run audit:prod"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
